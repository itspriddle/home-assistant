# Copy to secrets.yaml (git-ignored). Device folders include it via their
# own one-line secrets.yaml stub.
#
# API encryption keys (base64) - generate with: openssl rand -base64 32

# Wi-Fi
wifi_ssid: "x"
wifi_password: "x"

# HTTP auth for every device's web server (and the Tab5 /screenshot endpoint)
web_username: "x"
web_password: "x"

# Shared defaults (tab5-dashboard, speedtest-gauge, cyd-weather, base.yaml)
api_encryption_key: "x"
ota_password: "x"
fallback_ap_password: "x"

# treemote
treemote_api_encryption_key: "x"
treemote_ota_password: "x"
treemote_fallback_ap_password: "x"

# uplift-desk
uplift_desk__api_encryption_key: "x"

# cyd-weather
cyd_weather_api_encryption_key: "x"

# samsung-controller
samsung_controller__api_encryption_key: "x"

# cyd-emby
cyd_emby_api_encryption_key: "x"
