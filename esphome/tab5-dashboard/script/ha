#!/usr/bin/env bash
# Query Home Assistant API
# Requires: HA_URL and HA_TOKEN environment variables (via .envrc)

set -euo pipefail

: "${HA_URL:?Set HA_URL in .envrc (e.g., http://homeassistant.local:8123)}"
: "${HA_TOKEN:?Set HA_TOKEN in .envrc (long-lived access token from HA)}"

usage() {
  cat <<EOF
Usage: ha <command> [args]

Commands:
  states              List all entity IDs
  state <entity_id>   Get state of specific entity
  search <pattern>    Search entity IDs (grep pattern)
  get <entity_id>     Get full entity details (JSON)
  services            List available services
  raw <endpoint>      Raw API call (e.g., "raw /api/config")

Examples:
  ha states
  ha search temperature
  ha search "binary_sensor.*motion"
  ha state sensor.living_room_temperature
  ha get climate.thermostat
EOF
  exit 1
}

api() {
  curl -s -H "Authorization: Bearer $HA_TOKEN" "${HA_URL}$1"
}

case "${1:-}" in
  states)
    api /api/states | jq -r '.[].entity_id' | sort
    ;;
  state)
    [[ -z "${2:-}" ]] && usage
    api "/api/states/$2" | jq -r '.state'
    ;;
  get)
    [[ -z "${2:-}" ]] && usage
    api "/api/states/$2" | jq .
    ;;
  search)
    [[ -z "${2:-}" ]] && usage
    api /api/states | jq -r '.[].entity_id' | grep -E "$2" | sort
    ;;
  services)
    api /api/services | jq -r '.[].domain' | sort -u
    ;;
  raw)
    [[ -z "${2:-}" ]] && usage
    api "$2" | jq .
    ;;
  *)
    usage
    ;;
esac
