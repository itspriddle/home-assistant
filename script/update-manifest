#!/usr/bin/env bash
set -e

# Generate a clean list of integrations installed
# This is useful for version control since we can't commit core.config_entries directly.

# Default to the standard location, but allow override (e.g. for testing with hadump)
CONFIG_ENTRIES=${1:-config/.storage/core.config_entries}

if [ ! -f "$CONFIG_ENTRIES" ]; then
    echo "Error: $CONFIG_ENTRIES not found."
    echo "Usage: $0 [path_to_core.config_entries]"
    exit 1
fi

OUTPUT_FILE="INTEGRATIONS.md"

echo "Generating $OUTPUT_FILE from $CONFIG_ENTRIES..."
echo "# Installed Integrations" > "$OUTPUT_FILE"
echo "" >> "$OUTPUT_FILE"
echo "This list is auto-generated by 
script/update-manifest
. Do not edit manually." >> "$OUTPUT_FILE"
echo "" >> "$OUTPUT_FILE"
echo "| Domain | Title | Source |" >> "$OUTPUT_FILE"
echo "| :--- | :--- | :--- |" >> "$OUTPUT_FILE"

# Use jq to format as a markdown table
jq -r '.data.entries[] | "| \(.domain) | \(.title) | \(.source) |"' "$CONFIG_ENTRIES" | sort >> "$OUTPUT_FILE"

echo "Done."
